PORT=3000
APP_BASE_URL=http://localhost:3000
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
N8N_WEBHOOK_URL=https://your-n8n.example.com/webhook/create-calendar
N8N_WEBHOOK_URL_SHEETS=https://your-n8n.example.com/webhook/create-sheet

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=api_calendar
DB_USER=api_calendar_user
DB_PASSWORD=change-this-to-a-strong-password

# Encryption Key (generate with: openssl rand -base64 32)
ENCRYPTION_KEY=change-this-to-a-32-byte-base64-key
